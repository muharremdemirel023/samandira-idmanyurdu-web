{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "samandiraidmanyurdu.com" }],
      "destination": "https://www.samandiraidmanyurdu.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "header", "key": "x-forwarded-proto", "value": "http" }],
      "destination": "https://www.samandiraidmanyurdu.com/:path*",
      "permanent": true
    }
  ]
}
